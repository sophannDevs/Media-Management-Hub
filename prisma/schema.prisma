// MediaFlow — AI content production & social publishing.
//
// Statuses and other enumerations are stored as string codes (see
// src/lib/workflow/statuses.ts) so new platforms / statuses can be added
// without a migration; CHECK constraints in the migrations keep them valid.

generator client {
  provider        = "prisma-client-js"
  // relationLoadStrategy: "join" loads a row and its relations in one SQL statement (PERF-04 budget)
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The workspace owner (single user for now; roles come later).
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  /// Argon2id PHC string. Null until the owner sets a password at /setup.
  passwordHash String?
  /// OWNER for now
  role         String        @default("OWNER")
  /// Failed sign-ins in a row; at 5 the account is locked for 15 minutes
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  activities   ActivityLog[]
  sessions     Session[]
  savedViews   SavedView[]
}

/// A named set of Content list filters and sort, per user (UX-02)
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// The list's query string without paging, e.g. "stage=READY&sort=priority"
  query     String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored here.
model Session {
  /// SHA-256 (hex) of the cookie token
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String   @default("")

  @@index([userId])
  @@index([expiresAt])
}

/// Workspace-wide configuration (single row, id = 1).
model WorkspaceSettings {
  id                    Int      @id @default(1)
  workspaceName         String   @default("MediaFlow")
  timezone              String   @default("Asia/Phnom_Penh")
  defaultLanguage       String   @default("English")
  requireScriptApproved Boolean  @default(true)
  requireImagesApproved Boolean  @default(true)
  requireFinalVideo     Boolean  @default(true)
  requireReview         Boolean  @default(true)
  requireThumbnail      Boolean  @default(false)
  autoRetry             Boolean  @default(true)
  maxRetries            Int      @default(3)
  retryDelayMinutes     Int      @default(15)
  /// { [notificationType]: boolean }
  notificationPrefs     Json     @default("{}")
  updatedAt             DateTime @updatedAt
}

/// Publishing destinations. `id` is the provider key, e.g. "youtube".
model Platform {
  id        String               @id
  name      String
  enabled   Boolean              @default(true)
  sortOrder Int                  @default(0)
  accounts  SocialAccount[]
  contents  ContentPlatform[]
  schedules PublishingSchedule[]
  snapshots AnalyticsSnapshot[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  contents  Content[]
}

model Series {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  contents  Content[]
}

model Campaign {
  id        String    @id @default(cuid())
  name      String    @unique
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  contents  Content[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  contents Content[]
}

model Content {
  id                String    @id @default(cuid())
  title             String
  idea              String    @default("")
  description       String    @default("")
  /// LONG_FORM | SHORT | REEL
  contentType       String    @default("LONG_FORM")
  targetAudience    String    @default("")
  language          String    @default("English")
  /// HIGH | MEDIUM | LOW
  priority          String    @default("MEDIUM")
  targetPublishDate DateTime?
  /// Default hashtags, space separated ("#ai #tools")
  hashtags          String    @default("")

  scriptStatus     String @default("NOT_STARTED")
  imageStatus      String @default("NOT_STARTED")
  videoStatus      String @default("NOT_STARTED")
  reviewStatus     String @default("NOT_STARTED")
  /// Derived from the statuses above + schedules. See syncPublishingStatus().
  publishingStatus String @default("DRAFT")

  // Also derived and kept current by syncPublishingStatus(), so lists can
  // filter, sort, count and page in SQL (WF-03).
  /// Pipeline stage: IDEA | SCRIPT | IMAGES | VIDEO | REVIEW | READY | SCHEDULED | PUBLISHED | FAILED
  stage        String      @default("IDEA")
  /// What keeps it from Ready to Post: one bit per REQUIREMENTS code (src/lib/workflow/rules.ts)
  missingMask  Int         @default(0)
  /// Checklist completion, 0-100
  completion   Int         @default(0)
  /// Image shown in lists: the thumbnail, else the first selected image, else the first image
  coverAssetId String?
  coverAsset   MediaAsset? @relation("ContentCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  titleFinalized       Boolean   @default(false)
  descriptionFinalized Boolean   @default(false)
  archivedAt           DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seriesId   String?
  series     Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  videoAssetId     String?     @unique
  videoAsset       MediaAsset? @relation("ContentVideo", fields: [videoAssetId], references: [id], onDelete: SetNull)
  thumbnailAssetId String?     @unique
  thumbnailAsset   MediaAsset? @relation("ContentThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  tags        Tag[]
  platforms   ContentPlatform[]
  script      Script?
  scriptDraft ScriptDraft?
  imagePrompt ImagePrompt?
  media       MediaAsset[]         @relation("ContentMedia")
  schedules   PublishingSchedule[]
  activities  ActivityLog[]
  snapshots   AnalyticsSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishingStatus])
  @@index([createdAt])
  /// Lists: not archived, by stage, newest first (also serves archivedAt alone)
  @@index([archivedAt, stage, updatedAt])
  @@index([coverAssetId])
}

model ContentPlatform {
  contentId  String
  platformId String
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([contentId, platformId])
}

model Script {
  id             String          @id @default(cuid())
  contentId      String          @unique
  content        Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  body           String          @default("")
  currentVersion Int             @default(0)
  versions       ScriptVersion[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ScriptVersion {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  version   Int
  body      String
  note      String   @default("")
  wordCount Int      @default(0)
  /// Script status at the moment the version was saved
  status    String   @default("GENERATED")
  /// MANUAL | PASTE | CLAUDE
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())

  @@unique([scriptId, version])
}

/// Script text being written and not yet saved as a version. Autosaved while
/// typing so a closed tab or a crash loses nothing (UX-03). It is not a version:
/// saving one replaces the draft, and a draft started from an older version
/// than the current one is ignored.
model ScriptDraft {
  contentId   String   @id
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  body        String
  /// Script.currentVersion when the editing started
  baseVersion Int
  updatedAt   DateTime @updatedAt
}

model ImagePrompt {
  id             String   @id @default(cuid())
  contentId      String   @unique
  content        Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  prompt         String   @default("")
  negativePrompt String   @default("")
  style          String   @default("Cinematic")
  aspectRatio    String   @default("16:9")
  /// GOOGLE_AI_STUDIO | GOOGLE_FLOW | OTHER
  provider       String   @default("GOOGLE_AI_STUDIO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  contentId   String?
  content     Content? @relation("ContentMedia", fields: [contentId], references: [id], onDelete: SetNull)
  /// IMAGE | VIDEO | THUMBNAIL | AUDIO | MUSIC | OTHER
  type        String
  fileName    String
  /// Key in the storage provider; null for externally linked files.
  /// Unique: every file request looks the asset up by it.
  storageKey  String?  @unique
  /// External URL when the file is linked rather than uploaded
  externalUrl String?
  mimeType    String   @default("application/octet-stream")
  size        Int      @default(0)
  width       Int?
  height      Int?
  durationSec Float?
  /// Images: chosen for the final video
  isSelected  Boolean  @default(false)
  createdAt   DateTime @default(now())

  videoFor       Content?             @relation("ContentVideo")
  thumbnailFor   Content?             @relation("ContentThumbnail")
  coverFor       Content[]            @relation("ContentCover")
  scheduleThumbs PublishingSchedule[]

  @@index([contentId, type])
  @@index([type])
}

model SocialAccount {
  id             String               @id @default(cuid())
  platformId     String
  platform       Platform             @relation(fields: [platformId], references: [id])
  name           String
  handle         String               @default("")
  avatarUrl      String?
  externalId     String?
  /// CONNECTED | DISCONNECTED | TOKEN_EXPIRED | ERROR
  status         String               @default("CONNECTED")
  /// OAuth credentials as ciphertext (src/lib/secrets.ts, SEC-04): "enc:v1:<key id>:…". Read and written only by services/tokens.ts.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  followers      Int                  @default(0)
  isDefault      Boolean              @default(false)
  lastSyncAt     DateTime?
  lastError      String?
  schedules      PublishingSchedule[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  // Also in migrations (not expressible here): at most one default account per platform
  // (unique index on platformId WHERE isDefault), and CHECK constraints on every status / type column.

  /// One connection per platform account (externalId is null until real OAuth fills it)
  @@unique([platformId, externalId])
  @@index([platformId])
}

/// A planned post of one content item to one platform/account.
model PublishingSchedule {
  id               String              @id @default(cuid())
  contentId        String
  content          Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platformId       String
  platform         Platform            @relation(fields: [platformId], references: [id])
  accountId        String
  account          SocialAccount       @relation(fields: [accountId], references: [id])
  scheduledAt      DateTime
  timezone         String
  title            String
  caption          String              @default("")
  hashtags         String              @default("")
  thumbnailAssetId String?
  thumbnailAsset   MediaAsset?         @relation(fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  /// YouTube: PUBLIC | UNLISTED | PRIVATE. Facebook: PUBLISH | DRAFT
  visibility       String              @default("PUBLIC")
  /// Platform-specific options
  options          Json                @default("{}")
  /// WAITING | PROCESSING | PUBLISHED | FAILED | RETRY_SCHEDULED | CANCELLED
  status           String              @default("WAITING")
  /// "contentId:accountId" while the post is active (waiting, processing or
  /// retrying), null otherwise: one active schedule per content and account.
  /// (Acts as the partial unique index Prisma can't express; see scheduleActiveKey.)
  activeKey        String?             @unique
  /// Token from the schedule form, so a resubmitted form can't create a second post
  idempotencyKey   String?             @unique
  /// Worker lease while PROCESSING: renewed by a heartbeat during the upload.
  /// Only an expired lease is recovered, and the platform is checked first.
  lockedBy         String?
  lockedUntil      DateTime?
  /// Provider state saved during an attempt (e.g. a resumable upload session)
  uploadState      Json?
  attempts         Int                 @default(0)
  nextAttemptAt    DateTime?
  lastError        String?
  /// AUTH | QUOTA | RATE | VALIDATION | NETWORK | UNKNOWN | UNKNOWN_OUTCOME
  lastErrorCode    String?
  externalId       String?
  externalUrl      String?
  publishedAt      DateTime?
  /// Published by a simulated provider: nothing reached the platform, and the
  /// external id / URL are made up. Never shown as "Published".
  simulated        Boolean             @default(false)
  /// Scheduled before "Ready to Post": the soft requirements waived for this
  /// post (array of requirement keys), why, when and by whom (WF-01).
  /// Hard requirements can't be waived.
  overrideRules    Json?
  overrideReason   String?
  overrideAt       DateTime?
  /// User id once sign-in exists
  overrideBy       String?
  /// Set when archiving the content cancelled this post: the status it had
  /// (WAITING | RETRY_SCHEDULED), so restoring can bring it back (WF-07).
  archivedStatus   String?
  jobs             PublishingJob[]
  snapshots        AnalyticsSnapshot[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, scheduledAt])
  /// Retry scan of the worker
  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([contentId])
  @@index([accountId])
  /// Calendar and queue, per platform and time
  @@index([platformId, scheduledAt])
}

/// One execution attempt of a PublishingSchedule.
model PublishingJob {
  id         String             @id @default(cuid())
  scheduleId String
  schedule   PublishingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attempt    Int
  /// PROCESSING | SUCCEEDED | FAILED
  status     String
  error      String?
  errorCode  String?
  startedAt  DateTime           @default(now())
  finishedAt DateTime?

  @@index([scheduleId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  message   String
  /// Extra details
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([contentId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  message   String
  href      String?
  /// Prevents duplicate notifications for the same event
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

/// Daily metrics per content/platform (mock for now; synced from APIs later).
model AnalyticsSnapshot {
  id           String              @id @default(cuid())
  /// MOCK (generated for simulated posts) | API (synced from the platform). Never mixed in one figure without a label.
  source       String              @default("MOCK")
  contentId    String
  content      Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platformId   String
  platform     Platform            @relation(fields: [platformId], references: [id])
  scheduleId   String?
  schedule     PublishingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  date         DateTime
  views        Int                 @default(0)
  likes        Int                 @default(0)
  comments     Int                 @default(0)
  shares       Int                 @default(0)
  watchMinutes Int                 @default(0)

  @@unique([contentId, platformId, date])
  @@index([date])
}

/// A running publishing worker proves it is alive here (PUB-11). Read by /api/health and Settings.
model WorkerHeartbeat {
  /// host:pid:random, the same id the worker puts in PublishingSchedule.lockedBy
  id         String    @id
  /// INLINE (inside the web server) | PROCESS (npm run worker) | CRON (POST /api/cron/publish)
  mode       String
  startedAt  DateTime  @default(now())
  lastBeatAt DateTime
  lastTickAt DateTime?
  lastTickMs Int?
  /// Posts this worker attempted since it started
  processed  Int       @default(0)

  @@index([lastBeatAt])
}

/// Periodic jobs that must run once per period whatever the number of workers (PUB-10).
model ScheduledTask {
  /// maintenance | analytics
  name           String    @id
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastDurationMs Int?
  lastError      String?
}

model AiPrompt {
  id        String   @id @default(cuid())
  name      String
  /// VIDEO_IDEA | SCRIPT | IMAGE | THUMBNAIL | TITLE | DESCRIPTION | HASHTAGS
  category  String
  /// CLAUDE | GOOGLE_AI_STUDIO | GOOGLE_FLOW | OTHER
  provider  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
