# PostgreSQL. `npm run db:start` creates a local server in .pgdata/ on port 5433 and
# `node scripts/db-local.mjs url` prints the value to put here. Any PostgreSQL 15+ works.
DATABASE_URL="postgresql://mediaflow:PASSWORD@127.0.0.1:5433/mediaflow"

# Where uploaded media is stored (local disk provider)
STORAGE_DIR="./storage"

# Largest single upload in bytes (default and maximum: 2 GiB minus one byte)
MEDIA_MAX_BYTES=""

# Optional: enables real "Generate with Claude". Without it, generation uses mock output.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Publishing worker. In development it runs inside the web server. In production
# run it as its own process next to `npm start`: `npm run worker` (one or more;
# they never send the same post twice). "true" also runs it inside the web
# server in production, "false" never does. /api/health reports whether one runs.
PUBLISH_WORKER_ENABLED=""
# How often the worker checks the queue (5–300 seconds)
PUBLISH_WORKER_INTERVAL_SECONDS="10"

# Enables POST /api/cron/publish for an external scheduler (send "Authorization: Bearer <secret>").
# Leave empty to keep the endpoint disabled (it answers 503).
CRON_SECRET=""

# Other sites allowed to send POST requests to the API (comma-separated hosts), e.g. behind a reverse proxy.
# The app's own host is always allowed.
ALLOWED_ORIGINS=""

# Set to "true" when the app is served over HTTPS: adds HSTS and upgrade-insecure-requests.
HTTPS_ONLY="false"

# Logging: LOG_LEVEL = debug | info | warn | error. LOG_FORMAT = json (one line per event,
# the default in production) | pretty (the default otherwise). Secrets are redacted.
LOG_LEVEL="info"
LOG_FORMAT=""
