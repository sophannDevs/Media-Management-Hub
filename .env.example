# Local SQLite database (switch provider to "postgresql" in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"

# Where uploaded media is stored (local disk provider)
STORAGE_DIR="./storage"

# Optional: enables real "Generate with Claude". Without it, generation uses mock output.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# In-process publishing worker (checks the queue every N seconds while the server runs)
PUBLISH_WORKER_ENABLED="true"
PUBLISH_WORKER_INTERVAL_SECONDS="60"

# Enables POST /api/cron/publish for an external scheduler (send "Authorization: Bearer <secret>").
# Leave empty to keep the endpoint disabled (it answers 503).
CRON_SECRET=""

# Other sites allowed to send POST requests to the API (comma-separated hosts), e.g. behind a reverse proxy.
# The app's own host is always allowed.
ALLOWED_ORIGINS=""

# Set to "true" when the app is served over HTTPS: adds HSTS and upgrade-insecure-requests.
HTTPS_ONLY="false"
