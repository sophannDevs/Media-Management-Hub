# Local SQLite database (switch provider to "postgresql" in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"

# Where uploaded media is stored (local disk provider)
STORAGE_DIR="./storage"

# Optional: enables real "Generate with Claude". Without it, generation uses mock output.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# In-process publishing worker (checks the queue every N seconds while the server runs)
PUBLISH_WORKER_ENABLED="true"
PUBLISH_WORKER_INTERVAL_SECONDS="60"

# Protects POST /api/cron/publish when called by an external scheduler
CRON_SECRET=""
