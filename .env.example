# PostgreSQL. `npm run db:start` creates a local server in .pgdata/ on port 5433 and
# `node scripts/db-local.mjs url` prints the value to put here. Any PostgreSQL 15+ works.
DATABASE_URL="postgresql://mediaflow:PASSWORD@127.0.0.1:5433/mediaflow"

# Where uploaded media is stored. Local disk by default (the folder below). For an
# S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO), set STORAGE_PROVIDER=s3
# and the S3_* variables; see docs/integrations/storage.md for the bucket's own settings
# (lifecycle rules, CORS for direct uploads, a CDN).
STORAGE_DIR="./storage"
STORAGE_PROVIDER=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Seconds a signed URL stays valid (60 to 604800)
S3_PRESIGN_TTL_SECONDS="900"
# "true": browsers upload straight to the bucket (presigned PUTs; the bucket needs a CORS rule) and,
# with STORAGE_DIRECT_GET, read files from it through signed URLs instead of through this server.
STORAGE_DIRECT_UPLOAD="false"
STORAGE_DIRECT_GET="false"

# Largest single upload in bytes (default and maximum: 2 GiB minus one byte)
MEDIA_MAX_BYTES=""

# Optional: enables real "Generate with Claude". Without it, generation uses mock output.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Publishing worker. In development it runs inside the web server. In production
# run it as its own process next to `npm start`: `npm run worker` (one or more;
# they never send the same post twice). "true" also runs it inside the web
# server in production, "false" never does. /api/health reports whether one runs.
PUBLISH_WORKER_ENABLED=""
# How often the worker checks the queue (5–300 seconds)
PUBLISH_WORKER_INTERVAL_SECONDS="10"

# ffprobe measures uploads and ffmpeg makes video posters and previews (PERF-08). Both are found
# on PATH; set these when they live elsewhere. Without them uploads still work.
FFPROBE_PATH=""
FFMPEG_PATH=""

# Encrypts the OAuth tokens stored for connected accounts (AES-256-GCM). Required to
# connect an account. "id:key" entries, comma-separated; the first one encrypts, all of
# them decrypt. `npm run secrets:key` prints a new entry (`npm run dev` adds one to .env
# when it is missing). Rotation: add a new entry first, run `npm run secrets:rotate`,
# then drop the old one. Keep it with your backups: without it the tokens are unreadable.
TOKEN_ENCRYPTION_KEYS=""

# Real publishing (PUB-07). Leave empty and the platform stays simulated. The public
# address of this app, used for the OAuth redirect URIs (must match what you register):
APP_URL=""
# Google Cloud: an OAuth client (Web application) with redirect URI <APP_URL>/api/oauth/youtube/callback,
# the YouTube Data API v3 enabled, scopes youtube.upload and youtube.readonly. While the consent
# screen is in "Testing", refresh tokens expire after 7 days: publish it before relying on it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Meta for Developers: an app with Facebook Login, redirect URI <APP_URL>/api/oauth/facebook/callback,
# permissions pages_show_list, pages_read_engagement, pages_manage_posts, publish_video (App Review
# for Pages other than the developer's own).
META_APP_ID=""
META_APP_SECRET=""

# Enables POST /api/cron/publish for an external scheduler (send "Authorization: Bearer <secret>").
# Leave empty to keep the endpoint disabled (it answers 503).
CRON_SECRET=""

# Other sites allowed to send POST requests to the API (comma-separated hosts), e.g. behind a reverse proxy.
# The app's own host is always allowed.
ALLOWED_ORIGINS=""

# Set to "true" when the app is served over HTTPS: adds HSTS and upgrade-insecure-requests.
HTTPS_ONLY="false"

# Logging: LOG_LEVEL = debug | info | warn | error. LOG_FORMAT = json (one line per event,
# the default in production) | pretty (the default otherwise). Secrets are redacted.
LOG_LEVEL="info"
LOG_FORMAT=""
